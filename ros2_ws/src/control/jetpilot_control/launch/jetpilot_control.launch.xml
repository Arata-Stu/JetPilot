<launch>
  <arg name="config_file" default="$(find-pkg-share jetpilot_control)/config/autonomous_control.param.yaml"/>
  <arg name="use_sim_time" default="false"/>

  <node pkg="jetpilot_control" exec="autonomous_control_node" name="autonomous_control_node" output="screen">
    <param from="$(var config_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
