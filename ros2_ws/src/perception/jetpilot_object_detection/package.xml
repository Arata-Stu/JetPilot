<?xml version="1.0"?>
<package format="3">
  <name>jetpilot_object_detection</name>
  <version>0.1.0</version>
  <description>Lightweight YOLOv8 TensorRT decoder for JetPilot.</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>cuda-toolkit</depend>
  <depend>diagnostic_msgs</depend>
  <depend>jetpilot_msgs</depend>
  <!-- TensorRT headers/library are provided by the Isaac ROS/JetPack image;
       CMake checks NvInfer.h and nvinfer (no upstream rosdep key exists). -->
  <depend>isaac_ros_common</depend>
  <depend>isaac_ros_nitros</depend>
  <depend>isaac_ros_nitros_tensor_list_type</depend>
  <depend>isaac_ros_tensor_list_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>isaac_ros_dnn_image_encoder</exec_depend>
  <exec_depend>isaac_ros_tensor_rt</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
