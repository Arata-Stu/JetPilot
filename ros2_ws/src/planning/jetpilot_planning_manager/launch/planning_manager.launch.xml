<launch>
  <arg name="params_file" default="$(find-pkg-share jetpilot_planning_manager)/config/planning_manager.param.yaml"/>
  <arg name="use_sim_time" default="false"/>
  <node pkg="jetpilot_planning_manager" exec="planning_manager_node" name="planning_manager_node" output="screen">
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
