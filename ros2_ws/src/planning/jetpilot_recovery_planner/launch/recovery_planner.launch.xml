<launch>
  <arg name="params_file" default="$(find-pkg-share jetpilot_recovery_planner)/config/recovery_planner.param.yaml"/>
  <arg name="use_sim_time" default="false"/>
  <node pkg="jetpilot_recovery_planner" exec="breadcrumb_recovery_planner_node" name="breadcrumb_recovery_planner_node" output="screen">
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
