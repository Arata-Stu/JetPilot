{
  "schema_version": 1,
  "kind": "sensor_kit",
  "id": "realsense-silky",
  "label": "RealSense + SilkyEvCam/OpenEB",
  "order": 30,
  "aliases": [
    "silky",
    "realsense_silky"
  ],
  "launch": {
    "package": "jetpilot_system_launch",
    "file": "launch/sensors/realsense_silky_evcam.launch.py"
  },
  "arguments": {
    "sensor_kit_camera_name": "realsense",
    "sensor_kit_rtp_image_topic": "/realsense/color/image_raw",
    "sensor_kit_enable_flir": false,
    "sensor_kit_silky_evcam_event_image_fps": 20.0,
    "sensor_kit_silky_evcam_event_image_style": "gep",
    "sensor_kit_silky_evcam_event_image_percentile": 90.0,
    "publish_vehicle_evs_description": true
  },
  "rtp_topics": [
    "/realsense/color/image_raw",
    "/event_camera/event_image",
    "/realsense/infra1/image_rect_raw",
    "/realsense/infra2/image_rect_raw"
  ]
}
