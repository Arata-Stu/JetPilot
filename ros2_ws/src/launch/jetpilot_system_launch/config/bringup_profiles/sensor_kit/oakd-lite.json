{
  "schema_version": 1,
  "kind": "sensor_kit",
  "id": "oakd-lite",
  "label": "Luxonis OAK-D Lite",
  "order": 20,
  "aliases": [
    "oakd",
    "oak-d-lite"
  ],
  "launch": {
    "package": "jetpilot_system_launch",
    "file": "launch/sensors/oakd_lite.launch.py"
  },
  "arguments": {
    "sensor_kit_camera_name": "oakd_lite",
    "sensor_kit_enable_depth": false,
    "sensor_kit_enable_color": true,
    "sensor_kit_rtp_image_topic": "/oakd_lite/rgb/image_raw",
    "sensor_kit_rtp_fps": 35,
    "sensor_kit_rtp_gop": 35,
    "sensor_kit_enable_flir": false,
    "localization_camera_name": "oakd_lite",
    "vgl_topic_config_file": "vgl_camera_topics_oakd_lite.yaml",
    "vslam_enable_imu": false,
    "vslam_imu_topic": "/oakd_lite/imu/data",
    "vehicle_description_camera_frame": "camera_link"
  },
  "rtp_topics": [
    "/oakd_lite/rgb/image_raw",
    "/oakd_lite/left/image_rect",
    "/oakd_lite/right/image_rect"
  ]
}
