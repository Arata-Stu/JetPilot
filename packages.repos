repositories:

  # ISAAC ROS
  ## isaac-ros-cli
  tools/isaac-ros-cli:
    type: git
    url: https://github.com/carbuncle01/isaac-ros-cli.git
    version: jetpilot-v1.0.0

  
  # Race Line
  ## global_racetrajectory_optimization
  python_ws/global_racetrajectory_optimization:
    type: git
    url: https://github.com/carbuncle01/global_racetrajectory_optimization.git
    version: jetpilot-v1.0.0

  # Tools

  ## custom_joy_node
  ros2_ws/src/tool/custom_joy_node:
    type: git
    url: https://github.com/carbuncle01/custom_joy_node.git
    version: jetpilot-v1.0.0

  # Vehicle
  ## pca9685 Tamiya TT-02
  ros2_ws/src/vehicle/pca9685_rc_interface:
    type: git
    url: https://github.com/carbuncle01/pca9685_rc_interface.git
    version: jetpilot-v1.0.0

  ## vesc 
  ros2_ws/src/vehicle/vesc_interface/vesc:
    type: git
    url: https://github.com/carbuncle01/vesc.git
    version: jetpilot-v1.0.0

  ## jetpilot vesc adapter
  ros2_ws/src/vehicle/vesc_interface/jetpilot_vesc_interface:
    type: git
    url: https://github.com/carbuncle01/jetpilot_vesc_interface.git
    version: jetpilot-v1.0.0

  ## jetpilot_bridge_interface
  ros2_ws/src/vehicle/jetpilot_bridge_interface:
    type: git
    url: https://github.com/carbuncle01/jetpilot_bridge_interface.git
    version: jetpilot-v1.0.0

  
  # Sensor
  
  ## openeb_ros2 Event Camera Driver
  ros2_ws/src/sensing/openeb_ros2:
    type: git
    url: https://github.com/carbuncle01/openeb_ros2.git
    version: jetpilot-v1.0.0

  # tool

  ## multi_sensor_calibration
  ros2_ws/src/tool/multi_sensor_calibration:
    type: git
    url: https://github.com/carbuncle01/multi_sensor_calibration.git
    version: jetpilot-v1.0.0

